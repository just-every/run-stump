{
  "schema": "rer-agent-surface/1",
  "seed": "stump",
  "specialist": "earned-channels-marketer",
  "capabilities": ["tools", "policy", "pause", "audit", "idempotency"],
  "tools": [
    { "name": "stump.findings.work", "scope": "stump:findings", "readOnly": false, "classes": ["standard"], "clauses": ["STUMP-WATCH-001", "STUMP-WATCH-005"] },
    { "name": "stump.calendar.pause", "scope": "stump:calendar", "readOnly": false, "classes": ["live"], "clauses": ["STUMP-PLAN-007"] },
    { "name": "stump.ledger.correct", "scope": "stump:ledger", "readOnly": false, "classes": ["standard"], "clauses": ["STUMP-LEDGER-001"] },
    { "name": "stump.ledger.search", "scope": "stump:ledger", "readOnly": true, "classes": ["standard"], "clauses": ["STUMP-LEDGER-001", "STUMP-LEDGER-002"] },
    { "name": "stump.links.manage", "scope": "stump:links", "readOnly": false, "classes": ["standard"], "clauses": ["STUMP-LINK-001"] },
    { "name": "stump.stack.connect", "scope": "stump:stack", "readOnly": false, "classes": ["security"], "clauses": ["STUMP-STACK-002", "STUMP-STACK-004"], "sponsorEscalation": false },
    { "name": "stump.stack.send", "scope": "stump:stack", "readOnly": false, "classes": ["standard", "sensitive"], "clauses": ["STUMP-STACK-002", "STUMP-STACK-004", "STUMP-SURFACE-015"] },
    { "name": "stump.team.manage", "scope": "stump:team", "readOnly": false, "classes": ["access"], "clauses": ["STUMP-TEAM-001"] },
    { "name": "stump.venues.fit", "scope": "stump:venues", "readOnly": false, "classes": ["standard"], "clauses": ["STUMP-VENUE-003"] },
    { "name": "stump.venues.manage", "scope": "stump:venues", "readOnly": false, "classes": ["standard"], "clauses": ["STUMP-VENUE-001"] },
    { "name": "stump.venues.members", "scope": "stump:venues", "readOnly": false, "classes": ["standard", "gated"], "clauses": ["STUMP-VENUE-006"] },
    { "name": "stump.venues.rules", "scope": "stump:venues", "readOnly": false, "classes": ["standard"], "clauses": ["STUMP-VENUE-002"] },
    { "name": "stump.watches.manage", "scope": "stump:watches", "readOnly": false, "classes": ["standard", "external", "security"], "clauses": ["STUMP-WATCH-001", "STUMP-WATCH-002", "STUMP-WATCH-003", "STUMP-WATCH-004", "STUMP-WATCH-013"], "sponsorEscalation": false }
  ],
  "notTools": [
    { "clauses": ["STUMP-VENUE-004", "STUMP-IMPORT-001"], "reason": "import-door" },
    { "clauses": ["STUMP-INBOX-005"], "reason": "screen" },
    { "clauses": ["STUMP-MOBILE-001", "STUMP-MOBILE-002", "STUMP-DRAFT-013"], "reason": "device" }
  ],
  "resources": [],
  "escalations": [
    { "id": "self-invite", "tool": "stump.team.manage", "args": { "action": "invite", "email": { "$sponsor": "email" }, "display_name": "Synthetic sponsor", "role": "admin", "connection": "employee" } }
  ],
  "spend": { "none": true },
  "witness": { "tool": "stump.ledger.search", "args": { "action": "search" } },
  "journey": [
    {
      "id": "invite",
      "tool": "stump.team.manage",
      "args": { "action": "invite", "email": { "$fixture": "invitee", "pointer": "" }, "display_name": "Synthetic contractor", "role": "contributor", "connection": "contractor" },
      "expect": [{ "class": "access", "facts": { "measure": 1, "direction": "widens" } }],
      "inject": { "classes": ["standard"], "risk": "none", "internal": true }
    },
    {
      "id": "pause",
      "tool": "stump.calendar.pause",
      "args": { "action": "pause", "scope": "all" },
      "expect": [{ "class": "live", "facts": { "measure": 1, "service": "all publishing" } }]
    },
    {
      "id": "resume",
      "tool": "stump.calendar.pause",
      "args": { "action": "resume", "scope": "all" },
      "expect": [{ "class": "live", "facts": { "measure": 1, "service": "all publishing" } }]
    },
    {
      "id": "ledger",
      "tool": "stump.ledger.search",
      "args": { "action": "search" },
      "expect": [{ "class": "standard" }]
    },
    {
      "id": "venue-create",
      "tool": "stump.venues.manage",
      "args": { "action": "create", "kind": "forum", "name": "Synthetic builders forum", "url": { "$fixture": "venue_url", "pointer": "" }, "status": "candidate" },
      "expect": [{ "class": "standard" }]
    },
    {
      "id": "venue-rules",
      "tool": "stump.venues.rules",
      "args": { "action": "set", "venue_id": { "$from": "venue-create", "pointer": "/id" }, "rules": {
        "posting": { "value": "members_only", "source_url": "https://example.com/rules", "read_at": "2026-10-30" },
        "gates": { "value": { "approval": true }, "source_url": "https://example.com/rules", "read_at": "2026-10-30" } } },
      "expect": [{ "class": "standard" }]
    },
    {
      "id": "venue-limit",
      "tool": "stump.venues.fit",
      "args": { "action": "set_limit", "venue_id": { "$from": "venue-create", "pointer": "/id" }, "limit": { "posts": 1, "per": "week" } },
      "expect": [{ "class": "standard" }]
    },
    {
      "id": "venue-apply",
      "tool": "stump.venues.members",
      "args": { "action": "apply", "venue_id": { "$from": "venue-create", "pointer": "/id" }, "handle": { "$fixture": "venue_handle", "pointer": "" } },
      "expect": [{ "class": "gated", "facts": { "step": "join application" } }]
    },
    {
      "id": "venue-approve",
      "tool": "stump.venues.members",
      "args": { "action": "approve_application", "application_id": { "$from": "venue-apply", "pointer": "/application/id" } },
      "expect": [{ "class": "standard" }]
    },
    {
      "id": "watch",
      "tool": "stump.watches.manage",
      "args": {
        "action": "create", "name": "Synthetic watch", "terms": { "any": ["synthetic"] }, "sources": [{ "kind": "rss", "url": "https://feeds.example.invalid/synthetic.xml" }],
        "alerts": { "immediate_min_relevance": 50, "slack": { "webhook_url": { "$fixture": "slack_webhook", "pointer": "" } }, "webhook": { "url": "https://receiver.example.invalid/hook", "secret": { "$fixture": "webhook_secret", "pointer": "" } } }
      },
      "expect": [{ "class": "standard", "facts": { "measure": 1 } }, { "class": "external", "facts": { "measure": 1, "counterparty": "public" } }, { "class": "security", "facts": { "measure": 1, "setting": "alert destinations" } }],
      "inject": { "classes": ["standard"], "risk": "none", "internal": true }
    },
    {
      "id": "mute",
      "tool": "stump.watches.manage",
      "args": { "action": "mute", "watch_id": { "$from": "watch", "pointer": "/id" } },
      "expect": [{ "class": "standard", "facts": { "measure": 1 } }],
      "inject": { "classes": ["standard"], "risk": "none", "internal": true }
    },
    {
      "id": "findings",
      "tool": "stump.findings.work",
      "args": { "action": "list", "watch_id": { "$from": "watch", "pointer": "/id" } },
      "expect": [{ "class": "standard", "facts": { "measure": 0 } }]
    },
    {
      "id": "link-rules",
      "tool": "stump.links.manage",
      "args": { "action": "set_rules", "own_domains": ["example.com"], "mediums": { "published": "social", "handoff": "community" } },
      "expect": [{ "class": "standard" }]
    },
    {
      "id": "connect-orbit",
      "tool": "stump.stack.connect",
      "args": { "action": "connect", "seed": "orbit", "origin": "https://orbit.invalid", "source_id": "stump", "secret": { "$fixture": "orbitSecret", "pointer": "" } },
      "expect": [{ "class": "security", "facts": { "measure": 1, "setting": "orbit connection" } }]
    },
    {
      "id": "stack-offers",
      "tool": "stump.stack.send",
      "args": { "action": "offers" },
      "expect": [{ "class": "standard" }, { "class": "sensitive", "facts": { "kind": "public handles and post links" } }]
    },
    {
      "id": "ledger-corrections",
      "tool": "stump.ledger.correct",
      "args": { "action": "corrections" },
      "expect": [{ "class": "standard" }]
    }
  ],
  "verification": {
    "owner": { "bindings": { "INSTALLATION_KEY": "sessionSecret" } },
    "fixtures": { "module": "tests/agent/fixtures.mjs" }
  }
}
