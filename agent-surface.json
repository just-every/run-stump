{
  "schema": "rer-agent-surface/1",
  "seed": "stump",
  "specialist": "earned-channels-marketer",
  "capabilities": ["tools", "policy", "pause", "audit", "idempotency"],
  "tools": [
    { "name": "stump.accounts.connect", "scope": "stump:accounts", "readOnly": false, "classes": ["security", "gated", "accounts"], "clauses": ["STUMP-PUBLISH-001", "STUMP-CONNECT-001"], "sponsorEscalation": false },
    { "name": "stump.calendar.pause", "scope": "stump:calendar", "readOnly": false, "classes": ["live"], "clauses": ["STUMP-PLAN-007"] },
    { "name": "stump.calendar.plan", "scope": "stump:calendar", "readOnly": false, "classes": ["standard", "live"], "clauses": ["STUMP-PLAN-002", "STUMP-PLAN-007", "STUMP-IMPORT-001"] },
    { "name": "stump.items.media", "scope": "stump:items", "readOnly": false, "classes": ["standard"], "clauses": ["STUMP-PUBLISH-002", "STUMP-PUBLISH-003", "STUMP-PUBLISH-004", "STUMP-PUBLISH-005"] },
    { "name": "stump.items.schedule", "scope": "stump:items", "readOnly": false, "classes": ["external", "money", "gated"], "clauses": ["STUMP-PUBLISH-002", "STUMP-PUBLISH-003", "STUMP-PUBLISH-004", "STUMP-PUBLISH-005", "STUMP-PUBLISH-006", "STUMP-DRAFT-010"] },
    { "name": "stump.ledger.search", "scope": "stump:ledger", "readOnly": true, "classes": ["standard"], "clauses": ["STUMP-LEDGER-001", "STUMP-LEDGER-002"] },
    { "name": "stump.setup.apps", "scope": "stump:setup", "readOnly": false, "classes": ["security", "gated"], "clauses": ["STUMP-CONNECT-002", "STUMP-SURFACE-004"], "sponsorEscalation": false },
    { "name": "stump.team.manage", "scope": "stump:team", "readOnly": false, "classes": ["access"], "clauses": ["STUMP-TEAM-001"] }
  ],
  "notTools": [
    { "clauses": ["STUMP-VENUE-004", "STUMP-IMPORT-001"], "reason": "import-door" },
    { "clauses": ["STUMP-INBOX-005"], "reason": "screen" },
    { "clauses": ["STUMP-MOBILE-001", "STUMP-MOBILE-002", "STUMP-DRAFT-013"], "reason": "device" }
  ],
  "resources": [],
  "escalations": [
    { "id": "self-invite", "tool": "stump.team.manage", "args": { "action": "invite", "email": { "$sponsor": "email" }, "display_name": "Synthetic sponsor", "role": "admin", "connection": "employee" } }
  ],
  "spend": { "none": true },
  "witness": { "tool": "stump.ledger.search", "args": { "action": "search" } },
  "journey": [
    {
      "id": "invite",
      "tool": "stump.team.manage",
      "args": { "action": "invite", "email": { "$fixture": "invitee", "pointer": "" }, "display_name": "Synthetic contractor", "role": "contributor", "connection": "contractor" },
      "expect": [{ "class": "access", "facts": { "measure": 1, "direction": "widens" } }],
      "inject": { "classes": ["standard"], "risk": "none", "internal": true }
    },
    {
      "id": "pause",
      "tool": "stump.calendar.pause",
      "args": { "action": "pause", "scope": "all" },
      "expect": [{ "class": "live", "facts": { "measure": 1, "service": "all publishing" } }]
    },
    {
      "id": "resume",
      "tool": "stump.calendar.pause",
      "args": { "action": "resume", "scope": "all" },
      "expect": [{ "class": "live", "facts": { "measure": 1, "service": "all publishing" } }]
    },
    {
      "id": "ledger",
      "tool": "stump.ledger.search",
      "args": { "action": "search" },
      "expect": [{ "class": "standard" }]
    },
    {
      "id": "setup-x",
      "tool": "stump.setup.apps",
      "args": { "action": "set", "network": "x", "client_id": { "$fixture": "xClientId", "pointer": "" }, "client_secret": { "$fixture": "xClientSecret", "pointer": "" } },
      "expect": [{ "class": "security", "facts": { "measure": 1, "setting": "x_app" } }, { "class": "gated", "facts": { "measure": 1, "provider": "x", "step": "developer_app" } }]
    },
    {
      "id": "connect-x",
      "tool": "stump.accounts.connect",
      "args": { "action": "start", "network": "x", "owner": "company" },
      "expect": [{ "class": "security", "facts": { "measure": 1, "setting": "network_connection" } }, { "class": "gated", "facts": { "measure": 1, "provider": "x", "step": "consent" } }, { "class": "accounts", "facts": { "measure": 1, "provider": "x" } }]
    },
    {
      "id": "finish-x",
      "tool": "stump.accounts.connect",
      "args": { "action": "complete", "connection_id": { "$from": "connect-x", "pointer": "/connection_id" }, "code": "synthetic-consent-code" },
      "expect": [{ "class": "security", "facts": { "measure": 1, "setting": "network_connection" } }, { "class": "accounts", "facts": { "measure": 1, "provider": "x" } }]
    },
    {
      "id": "slots-x",
      "tool": "stump.calendar.plan",
      "args": { "action": "set_slots", "account_id": { "$from": "finish-x", "pointer": "/account/id" }, "time_zone": "America/New_York", "slots": [{ "days": ["mon", "wed", "fri"], "times": ["09:00", "14:00"] }] },
      "expect": [{ "class": "standard", "facts": { "measure": 1 } }]
    }
  ],
  "verification": {
    "owner": { "bindings": { "INSTALLATION_KEY": { "module": "tests/agent/installation-key.mjs" } } },
    "fixtures": { "module": "tests/agent/fixtures.mjs" },
    "network": { "module": "tests/agent/network.mjs", "origins": ["https://api.x.com"] }
  }
}
