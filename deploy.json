{
  "version": 1,
  "project": "just-every/stump",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "crons": [
    "* * * * *"
  ],
  "originVar": "AUTH_ORIGIN",
  "publicOriginSetting": "PUBLIC_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "resend"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "INSTALLATION_KEY",
      "environment": "INSTALLATION_KEY"
    },
    {
      "binding": "INSTALLATION_KEY_PREVIOUS",
      "environment": "INSTALLATION_KEY_PREVIOUS",
      "optional": true
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM"
    },
    {
      "binding": "AI_ENABLED",
      "environment": "AI_ENABLED",
      "optional": true
    },
    {
      "binding": "AI_BASE_URL",
      "environment": "AI_BASE_URL",
      "optional": true
    },
    {
      "binding": "AI_MODEL",
      "environment": "AI_MODEL",
      "optional": true
    },
    {
      "binding": "AI_API_KEY",
      "environment": "AI_API_KEY",
      "optional": true
    }
  ]
}
